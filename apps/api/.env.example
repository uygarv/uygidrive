NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=uygidrive.appspot.com
FIREBASE_WEB_API_KEY=
DEFAULT_STORAGE_LIMIT_BYTES=2147483648
UPLOAD_INTENT_TTL_MINUTES=10080
TRASH_RETENTION_DAYS=30
# Set to true only together with Cloud Run's end-to-end HTTP/2 setting.
ENABLE_HTTP2=false
# Native PDF/image preview modules can be unstable in local macOS Node builds.
# Existing previews are still served. Enable only in a verified environment.
ENABLE_NATIVE_PREVIEWS=false
# A random secret with at least 32 characters. Required only for the scheduled HTTP purge endpoint.
MAINTENANCE_TOKEN=
# Set only while supporting legacy private sharing URLs.
LEGACY_SHARE_TOKEN_SECRET=
# Cloudflare Realtime TURN key ID and credential-generation API token. Never expose these to the browser.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
