NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Base64-encoded or raw JSON service-account credentials.
FIREBASE_SERVICE_ACCOUNT=

# Use the exact bucket name and api key shown in Firebase Storage for your project.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_WEB_API_KEY=

# Leave blank for host-only cookies. Set a parent domain (for example,
# .example.com) only when the web and API are deployed on sibling subdomains.
COOKIE_DOMAIN=

# Keep SESSION_COOKIE_NAME aligned with apps/web/.env.local
SESSION_COOKIE_NAME=uygidrive_session
CSRF_COOKIE_NAME=uygidrive_csrf

DEFAULT_STORAGE_LIMIT_BYTES=2147483648

UPLOAD_INTENT_TTL_MINUTES=10080
TRASH_RETENTION_DAYS=30

# Set to true only when using Cloud Run's HTTP/2 setting.
ENABLE_HTTP2=false

# Some native preview modules can be unstable in local macOS Node builds. Set with caution.
ENABLE_NATIVE_PREVIEWS=false

# A random secret with at least 32 characters. Required only for the scheduled HTTP purge endpoint.
MAINTENANCE_TOKEN=

# Set only while supporting legacy private sharing URLs. (optional)
LEGACY_SHARE_TOKEN_SECRET=

# Cloudflare Realtime TURN key ID and credential generation API token.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
