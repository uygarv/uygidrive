{
  "name": "@uygidrive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "migrate:legacy": "tsx src/scripts/migrate-legacy.ts",
    "check:usernames": "tsx src/scripts/check-usernames.ts",
    "purge:trash": "tsx src/scripts/purge-expired-trash.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "10.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@napi-rs/canvas": "^1.0.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ffmpeg": "^0.0.4",
    "firebase-admin": "^13.0.2",
    "jose": "^6.2.8",
    "pdfjs-dist": "^5.6.205",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
