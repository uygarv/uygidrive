# Public Fastify API origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public Next.js origin, used for share metadata.
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# Must match SESSION_COOKIE_NAME in ../api/.env.
NEXT_PUBLIC_SESSION_COOKIE_NAME=uygidrive_session
NEXT_PUBLIC_MOCK_DRIVE=false
# Optional: comma-separated LAN hostnames/IPs allowed to request Next.js dev
# assets. Use hostnames only, without http:// or a port.
# NEXT_ALLOWED_DEV_ORIGINS=192.168.68.118
